{
  "name": "@pebble/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-fixtures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-fixtures.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-demo-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:local": "VITE_PEBBLE_MODE=local vite --port 5175 --strictPort",
    "build:local": "VITE_PEBBLE_MODE=local vite build --outDir dist-local"
  },
  "dependencies": {
    "@fontsource-variable/work-sans": "5.3.0",
    "@pebble/schema": "0.1.0",
    "pinyin-pro": "3.29.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "vite": "8.3.2"
  }
}
